<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rigPlay SimHub plugin. net48, code-only WPF (no UseWPF, no XAML) so that `dotnet build` works on
       Linux against the Microsoft.NETFramework.ReferenceAssemblies package and the SimHub assemblies in ../lib. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>RigPlay</AssemblyName>
    <RootNamespace>RigPlayPlugin</RootNamespace>
    <Description>rigPlay: pairs CarPlay tablets with SimHub, picks the dashboard they show and plays their audio on the PC.</Description>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Concentus, the managed libopus, decodes the optional Opus audio format (docs/protocol.md §10.4). SimHub does
         not ship it, so it is the one assembly installed next to RigPlay.dll (CopyConcentus below; the package
         script zips it). Its dependencies System.Memory and System.Numerics.Vectors are SimHub's own copies, with
         SimHub's binding redirects, and are not copied. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Pinned to the versions SimHub 9.12.6 ships (System.Memory 4.0.1.2, Unsafe 6.0.0.0), so the build does not
         warn about Concentus asking for older ones; compile-only, never copied. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>

  <!-- CopyLocalLockFileAssemblies is off (SimHub ships everything else), so copy Concentus.dll by hand. -->
  <Target Name="CopyConcentus" AfterTargets="Build">
    <Copy SourceFiles="@(ReferencePath)" Condition="'%(Filename)' == 'Concentus'" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Framework assemblies. WPF is referenced directly; there is no XAML to compile. -->
  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- SimHub assemblies, committed under plugin/lib (see lib/README.md). Private=false: SimHub ships every one
       of them, so they are compiled against and never copied next to RigPlay.dll. -->
  <ItemGroup>
    <Reference Include="SimHub.Plugins">
      <HintPath>../lib/SimHub.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>../lib/SimHub.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GameReaderCommon">
      <HintPath>../lib/GameReaderCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>../lib/log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MahApps.Metro">
      <HintPath>../lib/MahApps.Metro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- NAudio 2.2.1 as SimHub ships it, for the audio receiver (#24). -->
    <Reference Include="NAudio">
      <HintPath>../lib/NAudio.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio.Core">
      <HintPath>../lib/NAudio.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio.Wasapi">
      <HintPath>../lib/NAudio.Wasapi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NAudio.WinMM">
      <HintPath>../lib/NAudio.WinMM.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- The 64x64 left-menu icon, generated by ../scripts/make-icon.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/icon.png" LogicalName="RigPlay.Icon.png" />
    <!-- Approximate start/finish coordinates of a few circuits for fake GPS strategy C (#44), read by ShippedTracks. -->
    <EmbeddedResource Include="Resources/tracks.json" LogicalName="RigPlay.Tracks.json" />
  </ItemGroup>
</Project>
